# Unreal Engine project — generated and derived files.
# Rule of thumb: if the editor or the build tool can recreate it, it does not belong here.

# Editor / IDE
.vs/
.vscode/
.idea/
*.sln
*.slnx
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
*.xcodeproj
*.xcworkspace

# Compiled binaries — rebuilt from Source/ by UnrealBuildTool
Binaries/
Plugins/*/Binaries/

# Intermediate build artifacts, including UnrealHeaderTool generated code
Intermediate/
Plugins/*/Intermediate/

# Derived Data Cache — shader and asset cache, regenerated on demand
DerivedDataCache/

# Per-user editor state: window layout, last opened level, autosaves, logs
Saved/

# Packaged builds and build staging
Build/
!Build/**/*.ico

# Lighting build data — large, binary, regenerated by Build Lighting
*_BuiltData.uasset

# Compiler leftovers
*.obj
*.pdb
*.lib
*.exp
*.dll
*.exe
